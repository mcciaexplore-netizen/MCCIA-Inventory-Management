# Copy to .env (git-ignored) for local dev. In production (Vercel), set these as
# project environment variables instead — never commit real credentials.

# Zoho Mail (aistudio@mcciapune.com) SMTP, used to email purchase orders to vendors
# and internal alerts (low stock, maintenance complaints).
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_USER=aistudio@mcciapune.com
SMTP_PASS=
MAIL_FROM=aistudio@mcciapune.com

# Hub SSO: the Hub signs an EdDSA (Ed25519) JWT for this app's audience and POSTs it to /api/sso/callback.
# HUB_SSO_PUBLIC_KEY is the Hub's sso-public.b64 contents as-is (base64 of the PEM public key, one line);
# a plain PEM is accepted too.
# SSO_ENFORCE=true makes unauthenticated API calls answer 401 { reason: 'sso_required' } so the client
# can send the user to the Hub; password login keeps working either way.
HUB_SSO_PUBLIC_KEY=
HUB_URL=https://mccia-apphub.vercel.app
SSO_AUDIENCE=mccia-inventory
SSO_ENFORCE=false
