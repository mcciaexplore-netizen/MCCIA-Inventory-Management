# Copy to .env (git-ignored) for local dev; on Vercel set these as project environment variables.
# VITE_* values are baked into the client bundle at build time, so rebuild after changing them.

# true: signed-out users are sent to the Hub (VITE_HUB_URL/launch/mccia-inventory) instead of the
# login form. Usually paired with SSO_ENFORCE=true on the server.
VITE_SSO_ENFORCE=false
VITE_HUB_URL=https://mccia-apphub.vercel.app
